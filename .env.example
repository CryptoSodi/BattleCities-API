# Copy this file to .env.local for local development.
NODE_ENV=development
BATTLECITY_STORAGE_MODE=local
BATTLECITY_API_HOST=127.0.0.1
PORT=3001
BATTLECITY_WEB_BASE_URL=https://battlecities.com

# Enable only after configuring production storage and reward wallets.
BATTLECITY_COMPETITIONS_WORKER_ENABLED=0
BATTLECITY_LEADERBOARD_REWARDS_ENABLED=0
BATTLECITY_DROP_REWARDS_ENABLED=0

# Production: set NODE_ENV=production, BATTLECITY_STORAGE_MODE=postgres,
# and supply a real database URL before running npm run db:migrate.
DATABASE_URL=
BATTLECITY_DATABASE_SSL=require

# Checkout and swaps need independently generated secrets (32+ characters).
BATTLECITY_SHOP_QUOTE_SECRET=
BATTLECITY_SWAP_QUOTE_SECRET=
JUPITER_API_KEY=

# Supply the actual SKR mint and decimal count to enable SKR operations.
BATTLECITY_SKR_MINT=
BATTLECITY_SKR_DECIMALS=

# Native Unity Android FCM: configure one server-only credential for
# battle-cities-84acd. Leave blank to keep notification sending unavailable.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: isolated MagicBlock devnet experiment (test API only)
BATTLECITY_MAGICBLOCK_ENABLED=0
BATTLECITY_MAGICBLOCK_SESSION_SECRET=
BATTLECITY_MAGICBLOCK_PAYER_FILE=
